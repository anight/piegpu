# Circle is a separate clone (github.com/rsta2/circle, 51.1); our local change
# is kept in patches/
/circle/

# Circle build outputs
*.o
*.d
*.elf
*.lst
*.img
*.map
gpu/shaders.h

# Pico build outputs
pico/*/build/
pico/*/host/build/
pico/*/build.log

# generated by devtools/run.sh
devtools/logs/
devtools/usbboot/
__pycache__/

# SD card image contents (firmware copies and a built kernel)
sdcard/*
!sdcard/config.txt

# host Mesa for tools/glslc (tools/glslc/build-mesa.sh)
/third_party/
tools/glslc/build/
