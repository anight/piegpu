# Local change to Circle Step51.1 (c776b3c6): cap CDC IN transfers at 511 bytes so
# every transfer ends with a short packet (see devtools/devlink.h). Apply with:
#   cd circle && git apply ../patches/circle-cdc-short-packets.patch

diff --git a/lib/usb/gadget/usbcdcgadgetendpoint.cpp b/lib/usb/gadget/usbcdcgadgetendpoint.cpp
index 813198b6..2008f97f 100644
--- a/lib/usb/gadget/usbcdcgadgetendpoint.cpp
+++ b/lib/usb/gadget/usbcdcgadgetendpoint.cpp
@@ -107,9 +107,9 @@ void CUSBCDCGadgetEndpoint::OnTransferComplete (boolean bIn, size_t nLength)
 			unsigned nBytesAvail = GetQueueBytesAvail ();
 			if (nBytesAvail)
 			{
-				if (nBytesAvail > MaxInMessageSize)
+				if (nBytesAvail > MaxInMessageSize-1)	// see Write()
 				{
-					nBytesAvail = MaxInMessageSize;
+					nBytesAvail = MaxInMessageSize-1;
 				}
 
 				Dequeue (m_InBuffer, nBytesAvail);
@@ -182,9 +182,12 @@ int CUSBCDCGadgetEndpoint::Write (const void *pData, unsigned nLength)
 	m_bInActive = TRUE;
 
 	unsigned nBytesAvail = GetQueueBytesAvail ();
-	if (nBytesAvail > MaxInMessageSize)
+	// pigpu: stay below wMaxPacketSize (512), so that every transfer ends
+	// with a short packet. A full-size last packet without a following ZLP
+	// leaves the data pending in the host's (cdc_acm) read URB.
+	if (nBytesAvail > MaxInMessageSize-1)
 	{
-		nBytesAvail = MaxInMessageSize;
+		nBytesAvail = MaxInMessageSize-1;
 	}
 
 	Dequeue (m_InBuffer, nBytesAvail);
