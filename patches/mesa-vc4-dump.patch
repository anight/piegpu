+        const uint32_t *pgpu_values = (const uint32_t *) uniforms;
 
         for (int i = 0; i < uinfo->count; i++) {
                 enum quniform_contents contents = uinfo->contents[i];
@@ -358,6 +408,8 @@ vc4_write_uniforms(struct vc4_context *vc4, struct vc4_compiled_shader *shader,
