                          qir_ITOF(c, qir_FRAG_Z(c)),
@@ -2694,6 +2701,15 @@ vc4_get_compiled_shader(struct vc4_context *vc4, enum qstage stage,
                 shader->bo = vc4_bo_alloc_shader(vc4->screen, c->qpu_insts,
