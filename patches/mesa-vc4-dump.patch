diff --git a/src/gallium/drivers/vc4/vc4_uniforms.c b/src/gallium/drivers/vc4/vc4_uniforms.c
index f63bbcd..8ab0104 100644
--- a/src/gallium/drivers/vc4/vc4_uniforms.c
+++ b/src/gallium/drivers/vc4/vc4_uniforms.c
@@ -187,6 +187,54 @@ get_texrect_scale(struct vc4_texture_stateobj *texstate,
         return fui(1.0f / dim);
 }
 
+
+/* pico-gpu: dump each compiled shader used by a draw (code, uniform stream
+ * layout and the values written for it) when PGPU_VC4_DUMP names a file.
+ * Used by pico-gpu/tools/glslc to precompile programs offline.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+
+static void
+pgpu_dump_shader(struct vc4_context *vc4, struct vc4_compiled_shader *shader,
+                 const uint32_t *values)
+{
+        const char *path = getenv("PGPU_VC4_DUMP");
+        if (!path)
+                return;
+        FILE *f = fopen(path, "a");
+        if (!f)
+                return;
+
+        const char *stage = shader == vc4->prog.fs ? "fs" :
+                            shader == vc4->prog.vs ? "vs" :
+                            shader == vc4->prog.cs ? "cs" : "?";
+        fprintf(f, "{\"stage\": \"%s\", \"id\": %llu, \"threaded\": %d, "
+                "\"num_inputs\": %u, \"disable_early_z\": %d, "
+                "\"color_inputs\": %u, \"vattrs_live\": %u, \"vattr_offsets\": [",
+                stage, (unsigned long long) shader->program_id,
+                shader->fs_threaded, shader->num_inputs,
+                shader->disable_early_z, shader->color_inputs,
+                shader->vattrs_live);
+        for (int i = 0; i < 9; i++)
+                fprintf(f, "%s%u", i ? ", " : "", shader->vattr_offsets[i]);
+
+        const uint64_t *code = shader->pgpu_code;
+        unsigned n = shader->pgpu_code_count;
+        fprintf(f, "], \"code\": [");
+        for (unsigned i = 0; i < n; i++)
+                fprintf(f, "%s\"%016llx\"", i ? ", " : "",
+                        (unsigned long long) code[i]);
+
+        fprintf(f, "], \"uniforms\": [");
+        for (unsigned i = 0; i < shader->uniforms.count; i++)
+                fprintf(f, "%s[%u, %u, %u]", i ? ", " : "",
+                        shader->uniforms.contents[i],
+                        shader->uniforms.data[i], values[i]);
+        fprintf(f, "]}\n");
+        fclose(f);
+}
+
 void
 vc4_write_uniforms(struct vc4_context *vc4, struct vc4_compiled_shader *shader,
                    struct vc4_constbuf_stateobj *cb,
@@ -202,6 +250,7 @@ vc4_write_uniforms(struct vc4_context *vc4, struct vc4_compiled_shader *shader,
         struct vc4_cl_out *uniforms =
                 cl_start_shader_reloc(&job->uniforms,
                                       uinfo->num_texture_samples);
+        const uint32_t *pgpu_values = (const uint32_t *) uniforms;
 
         for (int i = 0; i < uinfo->count; i++) {
                 enum quniform_contents contents = uinfo->contents[i];
@@ -358,6 +407,8 @@ vc4_write_uniforms(struct vc4_context *vc4, struct vc4_compiled_shader *shader,
                 }
         }
 
+        pgpu_dump_shader(vc4, shader, pgpu_values);
+
         cl_end(&job->uniforms, uniforms);
 }
 
