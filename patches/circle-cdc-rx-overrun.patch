# Local change to Circle Step51.1 (c776b3c6): with the CDC gadget's receive
# queue full, OnTransferComplete called Enqueue with 0 bytes, whose assertion
# stopped the system; now the data is dropped only (m_nStatus: RX overrun).
# Apply after circle-cdc-short-packets.patch:
#   cd circle && git apply ../patches/circle-cdc-rx-overrun.patch

diff --git a/lib/usb/gadget/usbcdcgadgetendpoint.cpp b/lib/usb/gadget/usbcdcgadgetendpoint.cpp
index 813198b6..993d3b9f 100644
--- a/lib/usb/gadget/usbcdcgadgetendpoint.cpp
+++ b/lib/usb/gadget/usbcdcgadgetendpoint.cpp
@@ -92,7 +92,10 @@ void CUSBCDCGadgetEndpoint::OnTransferComplete (boolean bIn, size_t nLength)
 			m_nStatus = -1;		// RX overrun
 		}
 
-		Enqueue (m_OutBuffer, nLength);
+		if (nLength)			// (queue full: Enqueue asserts on 0)
+		{
+			Enqueue (m_OutBuffer, nLength);
+		}
 
 		m_SpinLock.Release ();
 
